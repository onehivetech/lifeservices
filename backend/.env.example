# ─────────────────────────────────────────────
# LIFE Services — Backend Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/lifeservices?schema=public"

# JWT secret (generate with: openssl rand -hex 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# Port
PORT=4000

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# (Optional) SendGrid for email notifications
SENDGRID_API_KEY=""
FROM_EMAIL="hello@lifeservices.com.au"
